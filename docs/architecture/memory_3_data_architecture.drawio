<mxGraphModel><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>

<!-- 标题 -->
<mxCell id="title" value="OpenHuman 独立记忆系统 — 数据架构图" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=16;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1000" height="40" as="geometry"/></mxCell>

<!-- ===== 文档存储区 ===== -->
<mxCell id="doc_bg" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=40;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="460" height="320" as="geometry"/></mxCell>
<mxCell id="doc_label" value="文档存储区 (Document Store)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#1a3a5c;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="20" as="geometry"/></mxCell>

<!-- documents 表 -->
<mxCell id="documents" value="documents&#xa;─────────────────────&#xa;PK  id: TEXT (UUID)&#xa;    source: TEXT&#xa;    source_id: TEXT&#xa;    content: TEXT&#xa;    metadata: JSON&#xa;    created_at: INTEGER&#xa;    embedding: BLOB" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="200" height="175" as="geometry"/></mxCell>

<!-- chunks 表 -->
<mxCell id="chunks" value="chunks&#xa;─────────────────────&#xa;PK  id: TEXT (UUID)&#xa;FK  doc_id → documents&#xa;    content: TEXT&#xa;    token_count: INTEGER&#xa;    position: INTEGER&#xa;    embedding: BLOB&#xa;    score: REAL" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="100" width="200" height="175" as="geometry"/></mxCell>

<!-- kv_store 表 -->
<mxCell id="kv_store" value="kv_store&#xa;─────────────────────&#xa;PK  key: TEXT&#xa;    value: BLOB&#xa;    scope: TEXT&#xa;    updated_at: INTEGER&#xa;    ttl: INTEGER" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#1976d2;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="200" height="65" as="geometry"/></mxCell>

<!-- fts5 虚表 -->
<mxCell id="fts5" value="chunks_fts (FTS5)&#xa;─────────────────────&#xa;全文搜索虚表&#xa;对 chunks.content 建索引" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#1976d2;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="200" height="65" as="geometry"/></mxCell>

