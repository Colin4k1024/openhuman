<!-- sync_changelog 表 -->
<mxCell id="sync_changelog" value="sync_changelog&#xa;─────────────────────&#xa;PK  id: TEXT&#xa;    device_id: TEXT&#xa;    lamport_clock: INTEGER&#xa;    operation: TEXT&#xa;    entity_id: TEXT&#xa;    data: BLOB (encrypted)&#xa;    synced: BOOLEAN" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#e65100;strokeColor=#bf360c;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="200" height="155" as="geometry"/></mxCell>

<!-- device_registry 表 -->
<mxCell id="device_registry" value="device_registry&#xa;─────────────────────&#xa;PK  device_id: TEXT&#xa;    public_key: BLOB&#xa;    display_name: TEXT&#xa;    capabilities: JSON&#xa;    last_seen: INTEGER" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#e65100;strokeColor=#bf360c;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="440" width="200" height="120" as="geometry"/></mxCell>

<!-- ===== 联邦学习区 ===== -->
<mxCell id="fed_bg" value="" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=40;" vertex="1" parent="1"><mxGeometry x="510" y="410" width="540" height="200" as="geometry"/></mxCell>
