<!-- federation_patterns 表 -->
<mxCell id="federation_patterns" value="federation_patterns&#xa;─────────────────────&#xa;PK  id: TEXT&#xa;    pattern_type: TEXT&#xa;    content_hash: TEXT&#xa;    noised_score: REAL&#xa;    epsilon: REAL&#xa;    created_at: INTEGER&#xa;    shared: BOOLEAN" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#6a1b9a;strokeColor=#4a148c;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="530" y="440" width="230" height="155" as="geometry"/></mxCell>

<!-- privacy_audit 表 -->
<mxCell id="privacy_audit" value="privacy_audit&#xa;─────────────────────&#xa;PK  id: TEXT&#xa;    action: TEXT&#xa;    data_ref: TEXT&#xa;    gdpr_basis: TEXT&#xa;    erased_at: INTEGER" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#6a1b9a;strokeColor=#4a148c;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="440" width="230" height="120" as="geometry"/></mxCell>

<!-- ===== 表关系连线 ===== -->
<mxCell id="r1" value="1:N" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="documents" target="chunks"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r2" value="1:N" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="entities" target="entity_relations"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r3" value="1:N" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#388e3c;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="graph_nodes" target="graph_edges"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r4" value="映射" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ffd700;strokeWidth=1;dashed=1;" edge="1" parent="1" source="entities" target="graph_nodes"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r5" value="FTS索引" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1976d2;strokeWidth=1;dashed=1;" edge="1" parent="1" source="chunks" target="fts5"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- ===== 数据流标注 ===== -->
<mxCell id="flow_write" value="① 写入流：文本 → documents → chunks → embedding向量" style="text;html=1;strokeColor=#1565c0;fillColor=#e8f4fd;rounded=1;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="635" width="460" height="30" as="geometry"/></mxCell>
<mxCell id="flow_retrieve" value="② 检索流：向量查询 → chunks（余弦相似度召回）→ 排序输出" style="text;html=1;strokeColor=#2e7d32;fillColor=#e8f5e9;rounded=1;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="510" y="635" width="540" height="30" as="geometry"/></mxCell>
<mxCell id="flow_sync" value="③ 同步流：本地写入 → sync_changelog（Lamport 时钟）→ XChaCha20 加密传输 → 对端 CRDT 合并" style="text;html=1;strokeColor=#e65100;fillColor=#fff3e0;rounded=1;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="675" width="700" height="30" as="geometry"/></mxCell>
<mxCell id="flow_fed" value="④ 联邦流：本地模式 → Laplace 加噪 → 秘密共享 → 聚合" style="text;html=1;strokeColor=#6a1b9a;fillColor=#f3e5f5;rounded=1;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="750" y="675" width="300" height="30" as="geometry"/></mxCell>

</root></mxGraphModel>
