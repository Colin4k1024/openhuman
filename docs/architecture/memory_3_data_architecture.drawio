<mxCell id="sync_bg" value="" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;opacity=40;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="460" height="200" as="geometry"/></mxCell>
