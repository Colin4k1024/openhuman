<mxCell id="graph_bg" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=40;" vertex="1" parent="1"><mxGeometry x="510" y="65" width="540" height="320" as="geometry"/></mxCell>
<mxCell id="graph_label" value="知识图谱区 (Knowledge Graph)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#1a5c2a;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="280" height="20" as="geometry"/></mxCell>

<!-- entities 表 -->
<mxCell id="entities" value="entities&#xa;─────────────────────&#xa;PK  id: TEXT&#xa;    name: TEXT&#xa;    entity_type: TEXT&#xa;    confidence: REAL&#xa;    first_seen: INTEGER&#xa;    last_seen: INTEGER&#xa;    metadata: JSON" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="530" y="100" width="200" height="165" as="geometry"/></mxCell>

<!-- entity_relations 表 -->
<mxCell id="entity_relations" value="entity_relations&#xa;─────────────────────&#xa;PK  id: TEXT&#xa;FK  from_entity → entities&#xa;FK  to_entity → entities&#xa;    relation_type: TEXT&#xa;    weight: REAL&#xa;    evidence: TEXT&#xa;    created_at: INTEGER" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="755" y="100" width="275" height="165" as="geometry"/></mxCell>

<!-- graph_nodes 表 -->
<mxCell id="graph_nodes" value="graph_nodes&#xa;─────────────────────&#xa;PK  id: TEXT&#xa;    label: TEXT&#xa;    node_type: TEXT&#xa;    embedding: BLOB&#xa;    metadata: JSON&#xa;    created_at: INTEGER" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#388e3c;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="530" y="285" width="200" height="85" as="geometry"/></mxCell>

<!-- graph_edges 表 -->
<mxCell id="graph_edges" value="graph_edges&#xa;─────────────────────&#xa;PK  id: TEXT&#xa;FK  from_node → graph_nodes&#xa;FK  to_node → graph_nodes&#xa;    edge_type: TEXT&#xa;    weight: REAL&#xa;    temporal_data: JSON" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#388e3c;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="755" y="285" width="275" height="95" as="geometry"/></mxCell>

