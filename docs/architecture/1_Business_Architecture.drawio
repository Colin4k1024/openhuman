    <mxCell id="b2" value="多渠道消息聚合&#xa;━━━━━━━━━━━&#xa;• WhatsApp / Telegram / Slack&#xa;• Discord / iMessage / LinkedIn&#xa;• Google Messages / Gmail&#xa;• 统一收发 &amp; 状态同步" style="rounded=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
