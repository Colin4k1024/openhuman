    <!-- 本地存储层 -->
    <mxCell id="local-group" value="本地数据层 (~/.openhuman/)" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="20" y="150" width="760" height="170" as="geometry"/>
    </mxCell>
    
    <mxCell id="l1" value="Threads Store&#xa;━━━━━━━━━━━━&#xa;• 对话历史 (messages)&#xa;• 工具调用记录&#xa;• 审批记录&#xa;• 文件系统持久化" style="rounded=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
      <mxGeometry x="35" y="175" width="140" height="125" as="geometry"/>
    </mxCell>
    
    <mxCell id="l2" value="Memory Pipeline&#xa;━━━━━━━━━━━━&#xa;• memory_graph (实体/关系)&#xa;• memory_store (KV)&#xa;• memory_tree (层级摘要)&#xa;• memory_entities (人物)&#xa;• memory_conversations&#xa;• memory_queue (处理队列)" style="rounded=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
      <mxGeometry x="190" y="175" width="170" height="125" as="geometry"/>
    </mxCell>
    
    <mxCell id="l3" value="Vector Store&#xa;━━━━━━━━━━━━&#xa;• Embeddings 索引&#xa;• 语义相似度检索&#xa;• 上下文窗口增强&#xa;• 本地向量计算" style="rounded=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
      <mxGeometry x="375" y="175" width="140" height="125" as="geometry"/>
    </mxCell>
    
    <mxCell id="l4" value="Config &amp; Credentials&#xa;━━━━━━━━━━━━━━&#xa;• TOML 配置文件&#xa;• Keyring (OS 凭证)&#xa;• Vault (加密存储)&#xa;• core.token (RPC 令牌)&#xa;• SecurityPolicy 状态" style="rounded=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
      <mxGeometry x="530" y="175" width="150" height="125" as="geometry"/>
    </mxCell>

